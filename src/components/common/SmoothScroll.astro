---
/**
 * SmoothScroll.astro — Lenis Momentum Smooth Scroll & Luxury Gold Progress Indicator
 *
 * Designed for Xile Spa Quiet Luxury aesthetic:
 * 1. Buttery momentum inertia scroll (Lenis) with relaxing easeOutExpo curve
 * 2. Top spun-gold reading progress bar with subtle amber glow
 * 3. Graceful anchor link jumping with sticky navbar offset
 * 4. Full accessibility support (prefers-reduced-motion)
 */
---

<!-- Top Reading/Scroll Progress Bar (Spun Gold Strand) -->
<div 
  id="scroll-progress-container" 
  class="fixed top-0 left-0 right-0 h-[2.5px] z-50 pointer-events-none overflow-hidden"
  aria-hidden="true"
>
  <div 
    id="scroll-progress-bar" 
    class="h-full w-full bg-gradient-to-r from-[#BD8B53] via-[#E4B87C] to-[#C86A4B] origin-left scale-x-0 will-change-transform shadow-[0_1px_8px_rgba(189,139,83,0.55)] transition-transform duration-75 ease-out"
  />
</div>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  declare global {
    interface Window {
      lenisInstance?: Lenis;
    }
  }

  function setupSmoothScrolling() {
    const progressBar = document.getElementById('scroll-progress-bar');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Fallback progress bar update for reduced motion or without Lenis
    const updateNativeProgress = () => {
      if (!progressBar) return;
      const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / totalScroll)) : 0;
      progressBar.style.transform = `scaleX(${progress})`;
    };

    if (prefersReducedMotion) {
      window.addEventListener('scroll', updateNativeProgress, { passive: true });
      updateNativeProgress();
      return;
    }

    // Initialize Lenis Momentum Smooth Scrolling
    const lenis = new Lenis({
      duration: 1.15,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Silky easeOutExpo curve
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.95, // Thư thái, nhịp nhàng đúng tinh thần Spa
      touchMultiplier: 1.2,
      infinite: false,
    });

    // Expose lenis instance to window for global access
    window.lenisInstance = lenis;

    // Connect progress bar to Lenis scroll events
    lenis.on('scroll', ({ progress }: { progress: number }) => {
      if (progressBar) {
        progressBar.style.transform = `scaleX(${progress})`;
      }
    });

    // Continuous requestAnimationFrame loop
    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // Smooth navigation for all internal anchor links (#loi-the, #services, #feedback, #vi-tri)
    const handleAnchorClick = (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest('a');
      if (!target) return;

      const href = target.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        const targetElement = document.querySelector(href);
        if (targetElement) {
          e.preventDefault();
          lenis.scrollTo(targetElement as HTMLElement, {
            offset: -84, // Trừ hao khoảng trống cho Sticky Header
            duration: 1.2,
          });
          // Update URL hash cleanly without instant browser jump
          history.pushState(null, '', href);
        }
      }
    };

    document.addEventListener('click', handleAnchorClick);

    // If page is loaded directly with a hash in URL
    if (window.location.hash) {
      setTimeout(() => {
        const initialTarget = document.querySelector(window.location.hash);
        if (initialTarget) {
          lenis.scrollTo(initialTarget as HTMLElement, {
            offset: -84,
            duration: 0.8,
          });
        }
      }, 250);
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSmoothScrolling);
  } else {
    setupSmoothScrolling();
  }
</script>
