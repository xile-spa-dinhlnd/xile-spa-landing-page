---
export interface Props {
  href?: string;
  target?: string;
  rel?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  ariaLabel?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  target,
  rel,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  ariaLabel,
  type = 'button',
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-full tracking-wide transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spa-bronze focus-visible:ring-offset-2 select-none active:scale-[0.98]';

const variantStyles = {
  primary: 'bg-spa-bronze hover:bg-[#B3956F] text-spa-cream shadow-spa-soft hover:shadow-spa-glow hover:-translate-y-0.5',
  secondary: 'bg-spa-sage-light hover:bg-[#DCE6DA] text-spa-charcoal border border-spa-sage/20 hover:-translate-y-0.5',
  outline: 'bg-transparent border border-spa-sage/30 hover:border-spa-sage text-spa-charcoal hover:bg-spa-sage-light/50 hover:-translate-y-0.5',
  ghost: 'bg-transparent text-spa-charcoal hover:bg-spa-beige/60',
};

const sizeStyles = {
  sm: 'text-xs px-4 py-2 gap-1.5',
  md: 'text-sm sm:text-base px-6 py-3 gap-2',
  lg: 'text-base sm:text-lg px-8 py-3.5 gap-2.5',
};

const widthStyle = fullWidth ? 'w-full' : 'w-auto';
const combinedClass = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${widthStyle} ${className}`.trim();

// Tự động thêm rel="noopener noreferrer" nếu target="_blank"
const computedRel = target === '_blank' ? (rel || 'noopener noreferrer') : rel;
---

{
  href ? (
    <a 
      href={href} 
      target={target} 
      rel={computedRel} 
      class={combinedClass} 
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button 
      type={type} 
      class={combinedClass} 
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
