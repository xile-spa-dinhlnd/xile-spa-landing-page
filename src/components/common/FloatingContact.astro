---
import { CONTACT_CONFIG } from '@/data/contact';
import { Phone } from 'lucide-react';
---

<aside class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 flex flex-col gap-3 items-end" aria-label="Kênh liên hệ nhanh Xile Spa">
  <!-- Hotline Call Button -->
  <a
    href={CONTACT_CONFIG.HOTLINE_TEL}
    aria-label={`Gọi hotline Xile Spa: ${CONTACT_CONFIG.HOTLINE_DISPLAY}`}
    class="group relative flex items-center justify-center w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-spa-charcoal text-spa-cream shadow-spa-card hover:bg-spa-bronze hover:scale-110 transition-all duration-300"
  >
    <Phone className="w-5 h-5 group-hover:rotate-12 transition-transform duration-300" />
    <!-- Tooltip -->
    <span class="absolute right-14 bg-spa-charcoal text-spa-cream text-xs font-medium px-3 py-1 rounded-full whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-md pointer-events-none hidden sm:inline-block">
      Gọi {CONTACT_CONFIG.HOTLINE_DISPLAY}
    </span>
  </a>

  <!-- Zalo Button -->
  <a
    href={CONTACT_CONFIG.ZALO_URL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Nhắn tin Zalo với Xile Spa"
    class="group relative flex items-center justify-center w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-[#0068FF] text-white shadow-spa-card hover:scale-110 transition-all duration-300"
  >
    <span class="font-bold text-[11px] sm:text-xs tracking-tight">Zalo</span>
    <!-- Tooltip -->
    <span class="absolute right-14 bg-spa-charcoal text-spa-cream text-xs font-medium px-3 py-1 rounded-full whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-md pointer-events-none hidden sm:inline-block">
      Chat Zalo Tư Vấn
    </span>
  </a>

  <!-- Facebook Messenger Button with Pulse -->
  <a
    href={CONTACT_CONFIG.MESSENGER_URL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat Facebook Messenger với Xile Spa"
    class="group relative flex items-center justify-center w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-gradient-to-tr from-[#0084FF] to-[#00C6FF] text-white shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-300"
  >
    <!-- Ping pulse animation ring -->
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0084FF] opacity-35 pointer-events-none"></span>
    <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.91 1.455 5.518 3.735 7.18V22l3.417-1.875c.917.255 1.889.393 2.848.393 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.05 12.385l-2.613-2.787-5.099 2.787 5.61-5.952 2.678 2.787 5.034-2.787-5.61 5.952z"/>
    </svg>
    <!-- Tooltip -->
    <span class="absolute right-16 bg-spa-charcoal text-spa-cream text-xs font-medium px-3 py-1.5 rounded-full whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-md pointer-events-none hidden sm:inline-block">
      Đặt Lịch Messenger
    </span>
  </a>
</aside>
