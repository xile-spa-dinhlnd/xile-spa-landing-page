---
import { Image } from 'astro:assets';
import { CONTACT_CONFIG } from '@/data/contact';
import Container from '@/components/common/Container.astro';
import Badge from '@/components/common/Badge.astro';
import Button from '@/components/common/Button.astro';
import heroImage from '@/assets/hero-spa.jpg';
import { Star, MapPin, Clock, ShieldCheck, Sparkles, ArrowRight } from 'lucide-react';
---

<section class="relative pt-8 pb-16 sm:pt-12 sm:pb-20 lg:pt-16 lg:pb-24 overflow-hidden bg-spa-cream" aria-label="Giới thiệu Xile Spa">
  <!-- Warm ambient glow background effects -->
  <div class="absolute -top-32 -left-32 w-[34rem] h-[34rem] bg-spa-bronze/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-0 w-[30rem] h-[30rem] bg-spa-sage/12 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 left-1/3 w-[28rem] h-[28rem] bg-amber-100/40 rounded-full blur-3xl pointer-events-none"></div>

  <Container size="wide">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">
      
      <!-- Left Column: Storytelling & Conversion Actions (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        
        <!-- Trust badge pill -->
        <div class="mb-5 sm:mb-6">
          <Badge variant="sage" hasDot={true} size="md">
            Dưỡng Sinh Trung Hoa • Chăm Da Mụn Nám • Sports Therapy
          </Badge>
        </div>

        <!-- H1 Chuẩn SEO cho Landing Page -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-[54px] xl:text-6xl text-spa-charcoal font-normal tracking-tight leading-[1.15] mb-5 sm:mb-6">
          Chạm Vào Yên Bình, <br class="hidden sm:inline" />
          <span class="italic text-spa-bronze font-serif">Tái Sinh Năng Lượng</span> Tự Nhiên
        </h1>

        <!-- Subtitle định vị rõ các giá trị cốt lõi -->
        <p class="text-base sm:text-lg text-spa-wood font-normal leading-relaxed max-w-2xl mb-8 sm:mb-10">
          Khám phá không gian chăm sóc toàn diện tại <strong>Xile Spa</strong>: Gội đầu dưỡng sinh Trung Hoa trị liệu cổ vai gáy, phác đồ chăm da mụn nám sẹo rỗ & peel da tái sinh, cùng kỹ thuật Sports Therapy phục hồi thể lực đỉnh cao.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 w-full sm:w-auto mb-10 sm:mb-12">
          <Button 
            href={CONTACT_CONFIG.FACEBOOK_FANPAGE_URL}
            target="_blank"
            variant="primary"
            size="lg"
            class="w-full sm:w-auto shadow-spa-card justify-center"
          >
            <span>Tư Vấn & Đặt Lịch Ngay</span>
            <ArrowRight className="w-4 h-4 ml-1.5 transition-transform duration-300 group-hover:translate-x-1" />
          </Button>

          <Button 
            href={CONTACT_CONFIG.MENU_URL}
            target="_blank"
            variant="outline"
            size="lg"
            class="w-full sm:w-auto border-spa-bronze/30 text-spa-charcoal hover:bg-spa-beige/60 justify-center"
          >
            <span>Xem Menu Giá Chi Tiết</span>
            <svg class="w-4 h-4 ml-1.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>
        </div>

        <!-- Social Proof & Trust Metrics Strip -->
        <div class="w-full pt-6 border-t border-spa-bronze/15 flex flex-wrap items-center gap-6 sm:gap-8 text-spa-charcoal">
          <!-- Rating -->
          <div class="flex items-center gap-2.5">
            <div class="flex items-center gap-0.5 text-spa-gold">
              <Star className="w-4 h-4 fill-spa-gold text-spa-gold" />
              <Star className="w-4 h-4 fill-spa-gold text-spa-gold" />
              <Star className="w-4 h-4 fill-spa-gold text-spa-gold" />
              <Star className="w-4 h-4 fill-spa-gold text-spa-gold" />
              <Star className="w-4 h-4 fill-spa-gold text-spa-gold" />
            </div>
            <div class="text-xs sm:text-sm">
              <span class="font-bold text-spa-charcoal">5.0</span>
              <span class="text-spa-wood ml-1">(1.200+ đánh giá)</span>
            </div>
          </div>

          <!-- Quality commitment -->
          <div class="flex items-center gap-2 text-xs sm:text-sm text-spa-wood">
            <ShieldCheck className="w-4 h-4 text-spa-sage flex-shrink-0" />
            <span>100% Thảo Mộc Tự Nhiên Thuần Khiết</span>
          </div>

          <!-- Space commitment -->
          <div class="hidden md:flex items-center gap-2 text-xs sm:text-sm text-spa-wood">
            <Sparkles className="w-4 h-4 text-spa-bronze flex-shrink-0" />
            <span>Không Gian Riêng Tư Tuyệt Đối</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Framed Luxury Hero Visual (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Decorative ambient shadow frame -->
          <div class="absolute -inset-2 rounded-[34px] bg-gradient-to-tr from-spa-bronze/20 via-spa-sage/10 to-transparent blur-lg opacity-70 pointer-events-none"></div>

          <!-- Main Framed Image Container -->
          <div class="relative rounded-3xl sm:rounded-[32px] overflow-hidden shadow-spa-card border border-spa-bronze/25 bg-spa-cream aspect-[4/5] sm:aspect-[4/5] group">
            <Image 
              src={heroImage}
              alt="Không gian phòng trị liệu yên tĩnh và thư giãn tại Xile Spa"
              width={900}
              height={1125}
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />

            <!-- Subtle gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-spa-charcoal/65 via-transparent to-transparent pointer-events-none"></div>

            <!-- Top-right chip: Thảo mộc tự nhiên -->
            <div class="absolute top-4 right-4 z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-spa-cream/92 backdrop-blur-md text-spa-charcoal shadow-sm border border-spa-bronze/20">
                <span class="w-2 h-2 rounded-full bg-spa-sage"></span>
                <span>Bồ Kết & Thảo Mộc Tự Nhiên</span>
              </span>
            </div>

            <!-- Floating Info Card at Bottom of Image -->
            <div class="absolute bottom-4 left-4 right-4 z-10 bg-spa-cream/95 backdrop-blur-md p-4 sm:p-4.5 rounded-2xl border border-spa-bronze/20 shadow-spa-card">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-serif text-sm sm:text-base font-semibold text-spa-charcoal leading-snug">
                    Xile Beauty & Spa
                  </p>
                  <p class="text-[11px] sm:text-xs text-spa-wood flex items-center gap-1 mt-1">
                    <MapPin className="w-3 h-3 text-spa-bronze flex-shrink-0" />
                    <span>67 Đ. Hưng Phú, Quận 8, TP.HCM</span>
                  </p>
                </div>
                <div class="text-right flex-shrink-0">
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-spa-bronze px-2 py-0.5 rounded-full bg-spa-bronze/10">
                    <Clock className="w-3 h-3" />
                    <span>09:00 - 21:00</span>
                  </span>
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </Container>
</section>
