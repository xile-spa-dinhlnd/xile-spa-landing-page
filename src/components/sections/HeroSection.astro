---
import { CONTACT_CONFIG } from '@/data/contact';
import { GOOGLE_REVIEWS_STATS } from '@/data/testimonials';
import Container from '@/components/common/Container.astro';
import Badge from '@/components/common/Badge.astro';
import Button from '@/components/common/Button.astro';
import LotusScene from '@/components/interactive/LotusScene';
import { Star, MapPin, Clock, ShieldCheck, Sparkles, ArrowRight } from 'lucide-react';
---

<section class="relative pt-8 pb-16 sm:pt-12 sm:pb-20 lg:pt-16 lg:pb-24 overflow-hidden bg-spa-cream" aria-label="Giới thiệu Xile Spa">
  <!-- Warm ambient breathing glow background effects -->
  <div class="absolute -top-32 -left-32 w-[34rem] h-[34rem] bg-spa-bronze/20 rounded-full blur-3xl pointer-events-none animate-ambient-drift"></div>
  <div class="absolute top-1/3 right-0 w-[30rem] h-[30rem] bg-spa-sage/18 rounded-full blur-3xl pointer-events-none animate-ambient-reverse"></div>
  <div class="absolute -bottom-20 left-1/3 w-[28rem] h-[28rem] bg-amber-100/60 rounded-full blur-3xl pointer-events-none animate-ambient-breathe"></div>

  <Container size="wide">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">
      
      <!-- Left Column: Storytelling & Conversion Actions (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        
        <!-- Trust badge pill -->
        <div class="mb-5 sm:mb-6">
          <Badge variant="sage" hasDot={true} size="md">
            Dưỡng Sinh Trung Hoa • Chăm Da Mụn Nám • Sports Therapy
          </Badge>
        </div>

        <!-- H1 Chuẩn SEO cho Landing Page -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-[54px] xl:text-6xl text-spa-charcoal font-normal tracking-tight leading-[1.15] mb-5 sm:mb-6">
          Chạm Vào Yên Bình, <br class="hidden sm:inline" />
          <span class="italic text-spa-bronze font-serif">Tái Sinh Năng Lượng</span> Tự Nhiên
        </h1>

        <!-- Subtitle định vị rõ các giá trị cốt lõi — Tinh gọn, sang trọng & súc tích -->
        <p class="text-base sm:text-lg text-spa-wood font-normal leading-relaxed max-w-2xl mb-8 sm:mb-10">
          Không gian chăm sóc & trị liệu toàn diện tại <strong>Xile Spa</strong>: Gội dưỡng sinh xoa dịu thân tâm, chăm da phục hồi chuyên sâu và liệu pháp Sports Therapy giải cơ tầng sâu.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 w-full sm:w-auto mb-10 sm:mb-12">
          <Button 
            href={CONTACT_CONFIG.FACEBOOK_FANPAGE_URL}
            target="_blank"
            variant="primary"
            size="lg"
            class="w-full sm:w-auto shadow-spa-card justify-center"
          >
            <span>Tư Vấn & Đặt Lịch Ngay</span>
            <ArrowRight className="w-4 h-4 ml-1.5 transition-transform duration-300 group-hover:translate-x-1" />
          </Button>

          <Button 
            href={CONTACT_CONFIG.MENU_URL}
            target="_blank"
            variant="outline"
            size="lg"
            class="w-full sm:w-auto border-spa-bronze/30 text-spa-charcoal hover:bg-spa-beige/60 justify-center"
          >
            <span>Xem Menu Giá Chi Tiết</span>
            <svg class="w-4 h-4 ml-1.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>
        </div>

        <!-- Social Proof & Trust Metrics Strip -->
        <div class="w-full pt-6 border-t border-spa-bronze/15 flex flex-wrap items-center gap-6 sm:gap-8 text-spa-charcoal">
          <!-- Rating (Clickable link to Google Reviews section) -->
          <a href="#feedback" class="flex items-center gap-2.5 hover:opacity-85 transition-opacity group" aria-label={`Xem ${GOOGLE_REVIEWS_STATS.totalReviews} đánh giá 5 sao trên Google Maps`}>
            <div class="flex items-center gap-0.5 text-amber-500">
              <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
            </div>
            <div class="text-xs sm:text-sm">
              <span class="font-bold text-spa-charcoal">5.0</span>
              <span class="text-spa-wood ml-1 group-hover:text-spa-bronze transition-colors">({GOOGLE_REVIEWS_STATS.totalReviews} đánh giá Google)</span>
            </div>
          </a>

          <!-- Quality commitment -->
          <div class="flex items-center gap-2 text-xs sm:text-sm text-spa-wood">
            <ShieldCheck className="w-4 h-4 text-spa-sage flex-shrink-0" />
            <span>100% Thảo Mộc Tự Nhiên Thuần Khiết</span>
          </div>

          <!-- Space commitment -->
          <div class="hidden md:flex items-center gap-2 text-xs sm:text-sm text-spa-wood">
            <Sparkles className="w-4 h-4 text-spa-bronze flex-shrink-0" />
            <span>Không Gian Riêng Tư Tuyệt Đối</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Seamless 3D Lotus Sanctuary (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer warm breathing aura halo -->
          <div class="hero-lotus-aura" aria-hidden="true"></div>

          <!-- Ground contact shadow for organic depth -->
          <div class="hero-lotus-contact-shadow" aria-hidden="true"></div>

          <!-- Seamless 3D Lotus Scene (React Island with full 360 drag interaction) -->
          <div class="hero-lotus-frame">
            <LotusScene 
              client:idle
              modelPath={`${import.meta.env.BASE_URL}/models/lotus.glb`.replace(/\/+/g, '/')} 
              className="rounded-3xl"
            />
            
            <!-- Overlay: Info badges floating gracefully above the 3D scene -->
            <div class="absolute top-4 right-4 z-20 pointer-events-none">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/80 backdrop-blur-md text-spa-charcoal shadow-sm border border-spa-bronze/25">
                <span class="w-2 h-2 rounded-full bg-spa-sage animate-pulse"></span>
                <span>Bồ Kết & Thảo Mộc Tự Nhiên</span>
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 z-20 bg-white/85 backdrop-blur-md p-4 rounded-2xl border border-spa-bronze/25 shadow-spa-card text-spa-charcoal pointer-events-none">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-serif text-sm sm:text-base font-semibold text-spa-charcoal leading-snug">
                    Xile Beauty & Spa
                  </p>
                  <p class="text-[11px] sm:text-xs text-spa-wood flex items-center gap-1 mt-1">
                    <MapPin className="w-3.5 h-3.5 text-spa-bronze flex-shrink-0" />
                    <span>67 Đ. Hưng Phú, Quận 8, TP.HCM</span>
                  </p>
                </div>
                <div class="text-right flex-shrink-0">
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-spa-bronze px-2.5 py-1 rounded-full bg-spa-bronze/10 border border-spa-bronze/25">
                    <Clock className="w-3 h-3" />
                    <span>09:00 - 21:00</span>
                  </span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </Container>
</section>

<style>
  /* ===== SEAMLESS AURA & CONTACT SHADOW ===== */
  .hero-lotus-aura {
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgba(217, 168, 105, 0.28) 0%,
      rgba(189, 139, 83, 0.1) 42%,
      transparent 70%
    );
    filter: blur(35px);
    pointer-events: none;
    animation: aura-breathe 6s ease-in-out infinite;
    z-index: 0;
  }

  .hero-lotus-contact-shadow {
    position: absolute;
    bottom: 10%;
    left: 18%;
    right: 18%;
    height: 38px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(80, 56, 38, 0.16) 0%,
      rgba(80, 56, 38, 0.05) 50%,
      transparent 75%
    );
    filter: blur(12px);
    pointer-events: none;
    animation: shadow-breathe 6s ease-in-out infinite;
    z-index: 0;
  }

  @keyframes aura-breathe {
    0%, 100% { opacity: 0.65; transform: scale(1); }
    50% { opacity: 0.95; transform: scale(1.06); }
  }

  @keyframes shadow-breathe {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.92); }
  }

  /* ===== SEAMLESS 3D FRAME ===== */
  .hero-lotus-frame {
    position: relative;
    z-index: 1;
    background: transparent;
  }

  /* ===== REDUCED MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    .hero-lotus-aura,
    .hero-lotus-contact-shadow {
      animation: none;
    }
  }
</style>
