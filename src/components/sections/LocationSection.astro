---
import { Image } from 'astro:assets';
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Button from '@/components/common/Button.astro';
import { CONTACT_CONFIG } from '@/data/contact';
import { MapPin, Phone, Clock, Navigation, ExternalLink } from 'lucide-react';

// Real authentic photos from the assets directory for space showcase
import spaceWashImg from '@/assets/head-spa-pics/hair-wash-02.jpg';
import spaceSkinImg from '@/assets/skincare-pics/skin-04.jpg';
import spaceHerbsImg from '@/assets/head-spa-pics/hair-wash-03.jpg';
import spacePrivateImg from '@/assets/skincare-pics/skin-06.jpg';

const spacePhotos = [
  {
    image: spaceWashImg,
    caption: 'Khu Vực Gội Đầu Dưỡng Sinh',
    sub: 'Giường gội êm ái, bồn vòm nước ấm tuần hoàn',
  },
  {
    image: spaceSkinImg,
    caption: 'Phòng Trị Liệu & Chăm Da',
    sub: 'Không gian chuẩn y khoa, ánh sáng dịu nhẹ',
  },
  {
    image: spaceHerbsImg,
    caption: 'Thảo Mộc Dưỡng Sinh Tự Nhiên',
    sub: 'Bồ kết, vỏ bưởi, sả chanh chuẩn thảo dược truyền thống',
  },
  {
    image: spacePrivateImg,
    caption: 'Không Gian Riêng Tư & Thư Giãn',
    sub: 'Mùi hương tinh dầu tự nhiên, âm nhạc thiền định',
  },
];
---

<section id="vi-tri" class="py-16 sm:py-20 lg:py-24 bg-spa-beige/40 relative overflow-hidden" aria-label="Không gian và vị trí Xile Spa">
  <Container>
    <!-- Section Heading -->
    <SectionHeading
      badgeText="Không Gian & Vị Trí"
      badgeVariant="sage"
      title="Điểm Đến Yên Bình,"
      titleHighlight="Thuận Tiện Kết Nối"
      subtitle="Tọa lạc tại mặt tiền đường Hưng Phú thoáng đãng, Xile Spa được thiết kế như một chốn trú ẩn ấm cúng, tách biệt khỏi mọi khói bụi và nhịp sống vội vã của Sài Gòn."
      align="center"
    />

    <!-- Space Gallery Grid: 4 authentic space photos -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mb-14 sm:mb-18">
      {spacePhotos.map((item, idx) => (
        <div class="group relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-spa-soft border border-spa-bronze/15 aspect-[3/4]">
          <Image
            src={item.image}
            alt={item.caption}
            width={600}
            height={800}
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-spa-charcoal/80 via-spa-charcoal/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 text-white">
            <p class="font-serif text-sm sm:text-base font-medium leading-snug">{item.caption}</p>
            <p class="text-[11px] sm:text-xs text-white/80 mt-0.5 line-clamp-1">{item.sub}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Main Contact & Google Maps Block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      <!-- Left Column: Information Cards (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-5">
        <!-- Address Card -->
        <div class="bg-spa-cream/95 backdrop-blur-sm rounded-3xl p-6 sm:p-7 border border-spa-bronze/20 shadow-spa-card">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-spa-sage/15 flex items-center justify-center flex-shrink-0 text-spa-sage">
              <MapPin className="w-6 h-6" />
            </div>
            <div class="flex-1">
              <h3 class="font-serif text-lg text-spa-charcoal font-medium mb-1">Địa Chỉ Chính Thức</h3>
              <p class="text-sm font-semibold text-spa-charcoal leading-snug">
                {CONTACT_CONFIG.SPA_ADDRESS}
              </p>
              <p class="text-xs text-spa-wood mt-1 leading-relaxed">
                {CONTACT_CONFIG.SPA_FULL_ADDRESS}
              </p>
              <div class="mt-4">
                <Button
                  href={CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL}
                  target="_blank"
                  variant="outline"
                  size="sm"
                  class="text-xs px-4 py-2 border-spa-bronze/30 text-spa-charcoal hover:bg-spa-beige/60 inline-flex items-center gap-1.5"
                >
                  <Navigation className="w-3.5 h-3.5 text-spa-bronze" />
                  <span>Mở Chỉ Đường Google Maps</span>
                </Button>
              </div>
            </div>
          </div>
        </div>

        <!-- Working Hours Card -->
        <div class="bg-spa-cream/95 backdrop-blur-sm rounded-3xl p-6 sm:p-7 border border-spa-bronze/20 shadow-spa-card">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-spa-bronze/15 flex items-center justify-center flex-shrink-0 text-spa-bronze">
              <Clock className="w-6 h-6" />
            </div>
            <div class="flex-1">
              <h3 class="font-serif text-lg text-spa-charcoal font-medium mb-1">Giờ Hoạt Động</h3>
              <p class="text-sm font-semibold text-spa-bronze">
                {CONTACT_CONFIG.OPENING_HOURS}
              </p>
              <p class="text-xs text-spa-wood mt-1.5 leading-relaxed">
                Khung giờ vàng từ 17:00 – 20:30 thường đông khách. Quý khách vui lòng đặt hẹn trước để có trải nghiệm trọn vẹn nhất.
              </p>
            </div>
          </div>
        </div>

        <!-- Direct Booking Call Card -->
        <div class="bg-gradient-to-br from-spa-charcoal to-[#3D332A] text-spa-cream rounded-3xl p-6 sm:p-7 shadow-spa-card flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-spa-bronze text-xs font-semibold uppercase tracking-wider mb-2">
              <span class="w-2 h-2 rounded-full bg-spa-bronze animate-pulse"></span>
              <span>Tư Vấn & Giữ Chỗ Nhanh</span>
            </div>
            <h3 class="font-serif text-2xl font-normal text-spa-cream leading-tight">
              Hotline: {CONTACT_CONFIG.HOTLINE_DISPLAY}
            </h3>
            <p class="text-xs text-spa-cream/75 mt-1.5 leading-relaxed">
              Hỗ trợ tư vấn tình trạng cơ bắp, soi da và tư vấn liệu trình phù hợp hoàn toàn miễn phí.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 mt-6">
            <a
              href={CONTACT_CONFIG.HOTLINE_TEL}
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-spa-bronze hover:bg-spa-bronze/90 text-spa-cream text-xs font-medium transition-all shadow-sm"
            >
              <Phone className="w-3.5 h-3.5" />
              <span>Gọi Ngay</span>
            </a>
            <a
              href={CONTACT_CONFIG.ZALO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-spa-cream text-xs font-medium border border-white/20 transition-all"
            >
              <ExternalLink className="w-3.5 h-3.5" />
              <span>Chat Zalo</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Google Maps Iframe (7 cols) -->
      <div class="lg:col-span-7">
        <div class="relative w-full h-[400px] sm:h-[460px] lg:h-full min-h-[420px] rounded-3xl overflow-hidden shadow-spa-card border border-spa-bronze/20 bg-spa-cream">
          <!-- Google Maps Iframe Embed -->
          <iframe
            src={CONTACT_CONFIG.GOOGLE_MAPS_EMBED_URL}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Vị trí Xile Spa trên bản đồ Google Maps"
            class="w-full h-full object-cover filter contrast-[1.02] saturate-[1.05]"
          ></iframe>

          <!-- Overlay floating address card -->
          <div class="absolute bottom-4 left-4 right-4 sm:right-auto sm:max-w-xs z-10 bg-spa-cream/95 backdrop-blur-md p-4 rounded-2xl border border-spa-bronze/20 shadow-spa-card">
            <p class="font-serif text-sm font-semibold text-spa-charcoal">Xile Beauty & Spa</p>
            <p class="text-xs text-spa-wood mt-0.5">67 Đ. Hưng Phú, Quận 8, TP.HCM</p>
            <a
              href={CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-spa-bronze hover:underline mt-2"
            >
              <span>Xem đường đi trên Google Maps</span>
              <ExternalLink className="w-3 h-3" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
