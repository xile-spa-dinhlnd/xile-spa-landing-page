---
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import { TESTIMONIALS_DATA, GOOGLE_REVIEWS_STATS } from '@/data/testimonials';
import { CONTACT_CONFIG } from '@/data/contact';
import { Star, CheckCircle2, ArrowUpRight, Sparkles } from 'lucide-react';

// Soft pastel avatar backgrounds for initials
const avatarColors = [
  'bg-emerald-100 text-emerald-800',
  'bg-amber-100 text-amber-800',
  'bg-purple-100 text-purple-800',
  'bg-blue-100 text-blue-800',
  'bg-rose-100 text-rose-800',
];

function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
}
---

<section
  id="feedback"
  class="bg-spa-alabaster py-16 sm:py-20 lg:py-24 relative overflow-hidden"
  aria-label="Đánh giá từ khách hàng trên Google Maps cho Xile Spa"
>
  <!-- Ambient breathing glow background effects -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-spa-bronze/8 rounded-full blur-3xl pointer-events-none animate-ambient-drift"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-spa-sage/8 rounded-full blur-3xl pointer-events-none animate-ambient-reverse"></div>

  <Container>
    <SectionHeading
      badgeText="Google Maps Reviews"
      badgeVariant="gold"
      title="Cảm Nhận Thật,"
      titleHighlight="Từ Khách Hàng Thực Tế"
      subtitle="Được bảo chứng bởi 54 lượt đánh giá tuyệt đối 5.0 sao trên hệ thống bản đồ Google Maps."
      align="center"
    />

    <!-- Google Official Trust Badge Banner -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 max-w-3xl mx-auto mb-12 sm:mb-16 -mt-4 sm:-mt-6 p-4 sm:p-5 rounded-2xl bg-[#FCF9F5] border border-spa-bronze/20 shadow-spa-soft">
      <div class="flex items-center gap-3.5">
        <!-- Google "G" Icon -->
        <div class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center flex-shrink-0 border border-black/5">
          <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </div>

        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-base text-spa-charcoal tracking-tight">5.0</span>
            <div class="flex items-center gap-0.5 text-amber-500" aria-label="Đánh giá 5 sao">
              {Array.from({ length: 5 }).map(() => (
                <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              ))}
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
              Xuất Sắc
            </span>
          </div>
          <p class="text-xs sm:text-sm text-spa-wood mt-0.5">
            Dựa trên <strong>{GOOGLE_REVIEWS_STATS.totalReviews} bài đánh giá</strong> từ khách hàng tại XiLe Beauty & Spa
          </p>
        </div>
      </div>

      <!-- Action Button to Google Maps -->
      <a
        href={CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-spa-charcoal hover:text-spa-bronze bg-white hover:bg-spa-beige/60 px-4 py-2 rounded-full border border-spa-bronze/30 shadow-xs transition-colors flex-shrink-0 group"
      >
        <span>Xem tất cả trên Google Maps</span>
        <ArrowUpRight className="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </div>

    <!-- Testimonial Grid (6 Balanced Cards: 5 Real Google Reviews + 1 Community Invitation Card) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {TESTIMONIALS_DATA.map((item, idx) => (
        <article
          class="group relative flex flex-col justify-between bg-[#FCF9F5] rounded-3xl p-6 sm:p-7 shadow-spa-soft hover:shadow-spa-card hover:-translate-y-1 transition-all duration-300 border border-spa-bronze/15"
          aria-label={`Đánh giá từ ${item.clientName}`}
        >
          <!-- Top Row: Rating Stars & Google Mini Badge -->
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-0.5 text-amber-500" aria-label={`${item.rating} sao`}>
              {Array.from({ length: item.rating }).map(() => (
                <Star className="w-4 h-4 fill-amber-500 text-amber-500" />
              ))}
            </div>
            <div class="flex items-center gap-1 text-[11px] font-medium text-spa-wood/75 bg-spa-beige/60 px-2.5 py-1 rounded-full border border-spa-bronze/15">
              <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <span>Google Review</span>
            </div>
          </div>

          <!-- Real Comment Text -->
          <blockquote class="text-sm sm:text-[15px] text-spa-charcoal/90 leading-relaxed font-normal mb-5 flex-1">
            "{item.comment}"
          </blockquote>

          <!-- Service Tag -->
          <div class="mb-4">
            <span class="inline-block text-[11px] font-medium px-3 py-1 rounded-full bg-spa-sage-light text-spa-charcoal/75 border border-spa-sage/20 leading-snug">
              {item.serviceUsed}
            </span>
          </div>

          <!-- Client Info & Verification -->
          <div class="flex items-center gap-3 pt-3.5 border-t border-spa-wood/10">
            <!-- Avatar Initials -->
            <div
              class={`w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold tracking-tight shadow-xs ${avatarColors[idx % avatarColors.length]}`}
              aria-hidden="true"
            >
              {getInitials(item.clientName)}
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-1">
                <p class="text-sm font-semibold text-spa-charcoal truncate">{item.clientName}</p>
                <span class="text-[11px] text-spa-muted flex-shrink-0">{item.date}</span>
              </div>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="flex items-center gap-1 text-[11px] text-emerald-700 font-medium">
                  <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" />
                  Xác minh Google
                </span>
                {item.userMeta && (
                  <span class="text-[11px] text-spa-wood/60 truncate">
                    · {item.userMeta}
                  </span>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}

      <!-- 6th Card: Invitation to leave a Google Review -->
      <aside 
        class="group relative flex flex-col justify-between bg-gradient-to-br from-[#FAF5EE] to-[#EDE4D5]/80 rounded-3xl p-6 sm:p-7 border border-spa-bronze/30 shadow-spa-soft hover:shadow-spa-card transition-all duration-300"
        aria-label="Mời viết đánh giá trải nghiệm tại Xile Spa"
      >
        <div>
          <!-- Icon Pill -->
          <div class="w-11 h-11 rounded-2xl bg-spa-bronze/10 text-spa-bronze flex items-center justify-center mb-4 border border-spa-bronze/20">
            <Sparkles className="w-5 h-5" />
          </div>

          <h3 class="font-serif text-xl text-spa-charcoal font-medium mb-2.5">
            Bạn Đã Từng Ghé XiLe Spa?
          </h3>
          <p class="text-xs sm:text-sm text-spa-wood leading-relaxed mb-6">
            Mỗi góp ý và từng đánh giá 5 sao từ bạn là món quà trân quý nhất giúp tập thể XiLe Spa không ngừng nâng cao chất lượng dịch vụ và tay nghề.
          </p>
        </div>

        <!-- Write Review CTA Button -->
        <a
          href={CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full text-xs sm:text-sm font-semibold text-white bg-spa-bronze hover:bg-spa-bronze-dark px-5 py-3 rounded-full shadow-spa-card transition-all group-hover:scale-[1.01]"
        >
          <span>Viết Đánh Giá Trên Google</span>
          <ArrowUpRight className="w-4 h-4" />
        </a>
      </aside>
    </div>

    <!-- Bottom Reassurance -->
    <div class="mt-12 sm:mt-16 text-center">
      <p class="text-spa-wood text-sm sm:text-base mb-1">
        Tất cả cảm nhận trên được ghi nhận minh bạch và công khai từ tài khoản Google thật.
      </p>
      <p class="font-serif text-lg sm:text-2xl text-spa-charcoal italic">
        Trải nghiệm sự khác biệt ngay hôm nay tại 67 Đ. Hưng Phú, Quận 8.
      </p>
    </div>
  </Container>
</section>
