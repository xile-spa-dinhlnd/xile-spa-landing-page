---
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Badge from '@/components/common/Badge.astro';
import { USPS_DATA } from '@/data/usps';
import { Sparkles, Activity, Flower2, ShieldCheck } from 'lucide-react';
---

<section id="loi-the" class="py-16 sm:py-20 lg:py-24 bg-spa-beige/35 relative">
  <Container size="wide">
    <!-- Section Heading -->
    <SectionHeading 
      badgeText="Lợi Thế Khác Biệt"
      badgeVariant="bronze"
      title="3 Trụ Cột Trị Liệu & Chăm Sóc"
      titleHighlight="Độc Bản Tại Xile Spa"
      subtitle="Chúng tôi kết hợp hài hòa giữa thư giãn dưỡng sinh Trung Hoa thảo mộc tự nhiên, phác đồ điều trị da chuyên sâu và liệu pháp Sports Therapy giải cơ tầng sâu."
      align="center"
    />

    <!-- 3 Core USP Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {USPS_DATA.map((usp, index) => {
        const targetId = usp.id === 'usp-head-spa' ? '#service-head-spa' : usp.id === 'usp-skincare' ? '#service-skincare-peel' : '#service-sports-rehab';
        return (
          <a
            href={targetId}
            class="group relative flex flex-col justify-between p-7 sm:p-8 rounded-3xl bg-[#FCF9F5]/95 backdrop-blur-sm border border-spa-bronze/18 shadow-spa-soft hover:shadow-spa-card hover:-translate-y-1.5 transition-all duration-300"
          >
            <div>
              <!-- Header of card with icon and number -->
              <div class="flex items-center justify-between mb-6">
                <div class="w-13 h-13 rounded-2xl bg-spa-cream flex items-center justify-center border border-spa-bronze/20 group-hover:scale-110 group-hover:bg-spa-beige transition-all duration-300 shadow-sm">
                  {usp.iconName === 'sparkles' && <Sparkles className="w-6 h-6 text-spa-bronze" />}
                  {usp.iconName === 'activity' && <Activity className="w-6 h-6 text-spa-bronze" />}
                  {usp.iconName === 'flower2' && <Flower2 className="w-6 h-6 text-spa-bronze" />}
                  {usp.iconName === 'shield-check' && <ShieldCheck className="w-6 h-6 text-spa-bronze" />}
                </div>
                <span class="font-serif text-3xl font-light text-spa-wood/30 group-hover:text-spa-bronze/60 transition-colors">
                  0{index + 1}
                </span>
              </div>

              <!-- Badge Category -->
              <div class="mb-3">
                <Badge variant={index === 0 ? 'sage' : index === 1 ? 'terracotta' : 'bronze'} size="sm">
                  {usp.badgeTitle}
                </Badge>
              </div>

              <!-- Title -->
              <h3 class="font-serif text-xl sm:text-2xl text-spa-charcoal font-normal leading-snug mb-3.5 group-hover:text-spa-bronze transition-colors">
                {usp.title}
              </h3>

              <!-- Description -->
              <p class="text-sm sm:text-base text-spa-wood leading-relaxed font-light">
                {usp.description}
              </p>
            </div>

            <!-- Bottom indicator link -->
            <div class="mt-8 pt-4 border-t border-spa-wood/10 flex items-center justify-between text-xs font-medium text-spa-wood/75">
              <span>Tiêu chuẩn cá nhân hóa</span>
              <span class="text-spa-bronze group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
                Xem dịch vụ →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </Container>
</section>
