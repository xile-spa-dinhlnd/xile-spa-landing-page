---
import { Image } from 'astro:assets';
import { CONTACT_CONFIG } from '@/data/contact';
import Button from '@/components/common/Button.astro';
import Container from '@/components/common/Container.astro';
import logoMaster from '@/assets/xile_logo_master.webp';
---

<header class="sticky top-0 z-40 w-full bg-spa-cream/92 backdrop-blur-md border-b border-spa-bronze/15 shadow-spa-soft/20 transition-all duration-300">
  <Container size="wide">
    <div class="flex items-center justify-between h-18 lg:h-20 transition-all duration-300">
      <!-- Logo thương hiệu Xile Spa: Vòm lá ôm trọn chuẩn xác, to rõ, sắc nét Retina, tuyệt đối không đè chữ -->
      <a href="/" class="flex items-center group flex-shrink-0 py-1" aria-label="Xile Spa - Trang chủ">
        <Image 
          src={logoMaster} 
          alt="Xile Beauty & Spa - Trang chủ" 
          width={240}
          densities={[1.5, 2]}
          class="h-14 sm:h-15 lg:h-16 xl:h-[68px] w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu — Font thanh mảnh, khoảng cách tinh tế chuẩn Luxury -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-[13px] sm:text-sm font-medium tracking-wide text-spa-charcoal/85">
        <a href="#loi-the" class="relative py-1 hover:text-spa-bronze transition-colors after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-spa-bronze after:transition-all after:duration-300 hover:after:w-full">
          Thế Mạnh
        </a>
        <a href="#services" class="relative py-1 hover:text-spa-bronze transition-colors after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-spa-bronze after:transition-all after:duration-300 hover:after:w-full">
          Dịch Vụ Chủ Lực
        </a>
        <a href="#feedback" class="relative py-1 hover:text-spa-bronze transition-colors after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-spa-bronze after:transition-all after:duration-300 hover:after:w-full">
          Khách Hàng Nói Gì
        </a>
        <a href="#vi-tri" class="relative py-1 hover:text-spa-bronze transition-colors after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-spa-bronze after:transition-all after:duration-300 hover:after:w-full">
          Không Gian & Vị Trí
        </a>
      </nav>

      <!-- Action Buttons — Gọn gàng, thanh thoát -->
      <div class="flex items-center gap-2.5 sm:gap-3 lg:gap-4 flex-shrink-0">
        <!-- Hotline Gọi nhanh -->
        <a 
          href={CONTACT_CONFIG.HOTLINE_TEL}
          class="hidden sm:inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-medium text-spa-wood hover:text-spa-charcoal transition-colors px-3 py-1.5 rounded-full hover:bg-spa-beige/60"
          aria-label={`Gọi hotline Xile Spa: ${CONTACT_CONFIG.HOTLINE_DISPLAY}`}
        >
          <svg class="w-3.5 h-3.5 text-spa-bronze flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{CONTACT_CONFIG.HOTLINE_DISPLAY}</span>
        </a>

        <!-- Nút Xem Menu (Tab mới) -->
        <Button 
          href={CONTACT_CONFIG.MENU_URL}
          target="_blank"
          variant="outline"
          size="sm"
          class="hidden lg:inline-flex text-xs sm:text-[13px] px-4 py-2 border-spa-bronze/25 text-spa-charcoal hover:bg-spa-beige/50"
        >
          Xem Menu
        </Button>

        <!-- Nút CTA Đặt Lịch -->
        <Button 
          href={CONTACT_CONFIG.FACEBOOK_FANPAGE_URL}
          target="_blank"
          variant="primary"
          size="sm"
          class="text-xs sm:text-[13px] px-4 sm:px-5 py-2 shadow-spa-soft"
        >
          Đặt Lịch Ngay
        </Button>
      </div>
    </div>
  </Container>
</header>
