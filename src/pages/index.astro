---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import UspsSection from '@/components/sections/UspsSection.astro';
import ServicesSection from '@/components/sections/ServicesSection.astro';
import FeedbackSection from '@/components/sections/FeedbackSection.astro';
---

<BaseLayout 
  title="Xile Spa — Không Gian Dưỡng Sinh, Chăm Sóc Da & Sports Rehab Chuyên Sâu"
  description="Trải nghiệm gội đầu thư giãn thảo mộc, liệu trình peel da tái sinh đa tầng và phục hồi cơ bắp sports rehab tại Xile Spa. Nơi chăm sóc toàn diện cho nhan sắc & thể lực."
>
  <!-- Sticky Header / Navbar -->
  <Navbar />

  <main>
    <!-- Section 1: Hero Section -->
    <HeroSection />

    <!-- Section 2: Core USPs 3 Trụ Cột -->
    <UspsSection />

    <!-- Section 3: 3 Nhóm Dịch Vụ Chính -->
    <ServicesSection />

    <!-- Section 4: Social Proof - Đánh Giá Khách Hàng -->
    <FeedbackSection />
  </main>
</BaseLayout>
