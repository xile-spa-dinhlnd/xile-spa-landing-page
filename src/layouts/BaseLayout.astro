---
import '@/styles/global.css';
import { CONTACT_CONFIG } from '@/data/contact';
import { GOOGLE_REVIEWS_STATS } from '@/data/testimonials';
import SmoothScroll from '@/components/common/SmoothScroll.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Xile Spa — Không Gian Dưỡng Sinh, Chăm Da & Sports Rehab Chuyên Sâu",
  description = "Trải nghiệm gội đầu dưỡng sinh thảo mộc, liệu trình peel da tái sinh đa tầng và phục hồi cơ bắp sports rehab tại Xile Spa 67 Hưng Phú, Quận 8. Đặt lịch: 0909 722 408.",
  ogImage = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://xilespa.vn');
const absoluteOgImage = new URL(ogImage, canonicalURL).toString();

const schemaData = {
  "@context": "https://schema.org",
  "@type": ["BeautySalon", "DaySpa", "HealthAndBeautyBusiness"],
  "name": "XiLe Beauty & Spa",
  "alternateName": "Xile Spa",
  "image": absoluteOgImage,
  "telephone": CONTACT_CONFIG.HOTLINE_DISPLAY,
  "url": canonicalURL.toString(),
  "priceRange": "$$",
  "currenciesAccepted": "VND",
  "paymentAccepted": "Tiền mặt, Chuyển khoản ngân hàng, Quẹt thẻ, MoMo",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": CONTACT_CONFIG.SPA_ADDRESS,
    "addressLocality": "Quận 8",
    "addressRegion": "Hồ Chí Minh",
    "postalCode": "700000",
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.7505368,
    "longitude": 106.6811055
  },
  "hasMap": CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": GOOGLE_REVIEWS_STATS.rating.toString(),
    "reviewCount": GOOGLE_REVIEWS_STATS.totalReviews.toString(),
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "09:00",
      "closes": "21:00"
    }
  ],
  "sameAs": [
    CONTACT_CONFIG.FACEBOOK_FANPAGE_URL,
    CONTACT_CONFIG.MENU_URL,
    CONTACT_CONFIG.GOOGLE_MAPS_DIRECTIONS_URL
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Dịch Vụ Trị Liệu & Chăm Sóc XiLe Spa",
    "itemListElement": [
      {
        "@type": "OfferCatalog",
        "name": "Gội Đầu Dưỡng Sinh Thảo Mộc",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Gội Dưỡng Sinh Tĩnh Dưỡng (60 Phút)",
              "description": "9 bước khai thông kinh lạc, gội thảo dược ấm, vòm tuần hoàn và kéo khăn nóng."
            },
            "price": "179000",
            "priceCurrency": "VND"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Gội Dưỡng Sinh Signature Xile (90 Phút)",
              "description": "16 bước hoàng gia đỉnh cao: massage đá ngọc & đá nóng cổ vai gáy, xông tai nến, vòm tuần hoàn."
            },
            "price": "450000",
            "priceCurrency": "VND"
          }
        ]
      },
      {
        "@type": "OfferCatalog",
        "name": "Chăm Sóc Da & Peel Da Tái Sinh",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Chăm Sóc Da Chuyên Sâu (75 Phút)",
              "description": "Quy trình vô trùng y khoa làm sạch sâu, gom cồi mụn ẩn, điện di tinh chất phục hồi."
            },
            "price": "550000",
            "priceCurrency": "VND"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Peel Da Tái Sinh Đa Tầng (60 Phút)",
              "description": "Chemical & Bio Peel tái tạo da mụn thâm, làm sáng đều màu, se khít lỗ chân lông."
            },
            "price": "790000",
            "priceCurrency": "VND"
          }
        ]
      },
      {
        "@type": "OfferCatalog",
        "name": "Sports Rehab & Trị Liệu Cơ Mạc Sâu",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Sports Rehab & Giải Cơ Tầng Sâu (60 Phút)",
              "description": "Giải phóng điểm co cứng cơ bắp trigger points cho người chơi Pickleball, Gym, Chạy bộ và trị liệu cổ vai gáy."
            },
            "price": "490000",
            "priceCurrency": "VND"
          }
        ]
      }
    ]
  }
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF5EE" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="XiLe Beauty & Spa" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="XiLe Beauty & Spa" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Google Fonts Preconnect & Asynchronous Non-blocking Load with font-display: swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      rel="preload" 
      as="style" 
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" 
    />
    <link 
      rel="stylesheet" 
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" 
      media="print" 
      onload="this.media='all'" 
    />
    <noscript>
      <link 
        rel="stylesheet" 
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" 
      />
    </noscript>

    <!-- Structured Data (JSON-LD) Google Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-spa-cream text-spa-charcoal min-h-screen selection:bg-spa-bronze/20 selection:text-spa-bronze">
    <!-- Smooth Momentum Scrolling (Lenis) & Top Luxury Gold Progress Indicator -->
    <SmoothScroll />
    <slot />
  </body>
</html>
